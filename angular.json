{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "biofactory-lunar": {
            "projectType": "application",
            "schematics": {},
            "root": "",
            "sourceRoot": "src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "browser": "src/main.ts",
                        "tsConfig": "tsconfig.app.json",
                        "index": "src/index.html",
                        "styles": [
                            "src/styles.scss"
                        ],
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "public"
                            }
                        ],
                        "outputPath": "dist/biofactory-lunar",
                        "allowedCommonJsDependencies": [
                            "phaser"
                        ]
                    },
                    "configurations": {
                        "production": {
                            "optimization": true,
                            "sourceMap": false
                        },
                        "development": {
                            "optimization": false,
                            "sourceMap": true
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "configurations": {
                        "production": {
                            "buildTarget": "biofactory-lunar:build:production"
                        },
                        "development": {
                            "buildTarget": "biofactory-lunar:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "tsConfig": "tsconfig.spec.json",
                        "include": [
                            "src/**/*.ng.spec.ts"
                        ],
                        "coverage": false,
                        "coverageInclude": [
                            "src/app/layout/game-shell/game-shell.ts",
                            "src/app/game/phaser/phaser-game.ts"
                        ],
                        "coverageExclude": [
                            "**/*.ng.spec.ts",
                            "**/*.spec.ts",
                            "**/*.d.ts"
                        ],
                        "coverageReporters": [
                            "text",
                            "json-summary",
                            "lcov"
                        ],
                        "coverageThresholds": {
                            "statements": 90,
                            "branches": 90,
                            "functions": 90,
                            "lines": 90
                        }
                    }
                }
            }
        }
    },
    "cli": {
        "packageManager": "pnpm"
    }
}
